# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# NextAuth (Auth.js v5)
# Generar con: npx auth secret
AUTH_SECRET=reemplazar-con-un-valor-generado
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
AUTH_GOOGLE_ID=reemplazar-con-tu-client-id
AUTH_GOOGLE_SECRET=reemplazar-con-tu-client-secret

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=reemplazar-con-tu-api-key

# Alertas de presupuesto por email (pendiente de implementar — usar Resend o similar,
# no Telegram/WhatsApp). Agregar acá la env var correspondiente cuando se construya.
